<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Camera2Study" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <style name="CalcRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="CalcButtonNumber" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">#2D3033</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="CalcButtonNumberWide" parent="CalcButtonNumber">
        <item name="android:layout_weight">2</item>
    </style>

    <style name="CalcButtonOperator" parent="CalcButtonNumber">
        <item name="backgroundTint">#FF9800</item>
        <item name="android:textColor">#111315</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcButtonFunction" parent="CalcButtonNumber">
        <item name="backgroundTint">#AEB4BB</item>
        <item name="android:textColor">#111315</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="CalcButtonSpace">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
    </style>
</resources>
