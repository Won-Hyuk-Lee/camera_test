<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" android:fitsSystemWindows="true">
    <FrameLayout android:id="@+id/previewArea" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/landscapeControls">
        <androidx.camera.view.PreviewView android:id="@+id/previewView" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" app:implementationMode="compatible" />
        <com.example.camera2study.ui.GridOverlayView android:id="@+id/gridOverlayView" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:visibility="gone" android:importantForAccessibility="no" />
        <TextView android:id="@+id/txtLensInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="8dp" android:maxWidth="160dp" android:maxLines="1" android:ellipsize="end" android:padding="6dp" android:background="#99000000" android:textColor="#FFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/txtTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="8dp" android:maxWidth="220dp" android:maxLines="1" android:ellipsize="end" android:padding="6dp" android:background="#99000000" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:text="00:00 · 대기" />
        <SeekBar android:id="@+id/sliderExposure" android:layout_width="180dp" android:layout_height="48dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="48dp" android:visibility="gone" android:max="20" android:progress="10" android:contentDescription="노출 밝기 조절" android:thumbTint="#FFC107" android:progressTint="#FFC107" />
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/landscapeControls" android:layout_width="260dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ScrollView android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/zoomControlLayout" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/topQuickBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingHorizontal="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSettings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="설정" android:textColor="#FFFFFF" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGridToggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="격자 끔" android:textColor="#FFFFFF" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBrightness" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="밝기" android:textColor="#FFFFFF" android:textSize="14sp" android:contentDescription="밝기 조절 열기" />
    </LinearLayout>
    <LinearLayout android:id="@+id/captureSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/txtCaptureSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:textColor="#E6FFFFFF" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:clickable="true" android:focusable="true" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCaptureResult" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="촬영 결과 보기" android:visibility="gone" />
    </LinearLayout>
            </LinearLayout>
        </ScrollView>
    <LinearLayout android:id="@+id/zoomControlLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="6dp" app:layout_constraintBottom_toTopOf="@id/btnPauseResume" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:scrollbars="horizontal">
            <LinearLayout android:id="@+id/zoomPresetRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnZoom06" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="48dp" android:text="0.6×" android:textColor="#FFFFFF" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnZoom10" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="48dp" android:text="1.0×" android:textColor="#FFFFFF" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnZoom20" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="48dp" android:text="2×" android:textColor="#FFFFFF" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnZoom30" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="48dp" android:text="3×" android:textColor="#FFFFFF" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnZoom50" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="48dp" android:text="5×" android:textColor="#FFFFFF" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnZoom100" style="@style/Widget.Material3.Button.TextButton" android:layout_width="52dp" android:layout_height="48dp" android:text="10×" android:textColor="#FFFFFF" android:textSize="12sp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="0dp" app:cornerRadius="24dp" />
            </LinearLayout>
        </HorizontalScrollView>
        <com.google.android.material.slider.Slider android:id="@+id/sliderZoom" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="확대 배율" android:visibility="gone" android:valueFrom="0.6" android:valueTo="10.0" android:value="1.0" app:thumbColor="#FFC107" app:trackColorActive="#FFC107" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnPauseResume" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="일시정지" android:textSize="14sp" android:visibility="gone" app:layout_constraintBottom_toTopOf="@id/bottomBar" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/bottomBar" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:paddingHorizontal="16dp" android:paddingVertical="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.card.MaterialCardView android:id="@+id/btnPrivateVault" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="비공개 보관함 열기" android:focusable="true" app:cardCornerRadius="26dp" app:strokeColor="#FFFFFF" app:strokeWidth="1dp">
            <ImageView android:id="@+id/imgVaultThumbnail" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@android:drawable/ic_lock_lock" android:padding="8dp" />
        </com.google.android.material.card.MaterialCardView>
        <FrameLayout android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnRecord" style="@style/Widget.Material3.Button.IconButton" android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center" android:contentDescription="녹화 시작" android:background="@android:color/transparent" app:icon="@null" />
            <View android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center" android:background="@drawable/shutter_ring" android:importantForAccessibility="no" />
            <View android:id="@+id/shutterCenter" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:background="@drawable/shutter_center_video" android:importantForAccessibility="no" />
        </FrameLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSwitchFacing" style="@style/Widget.Material3.Button.IconButton" android:layout_width="52dp" android:layout_height="52dp" android:contentDescription="전면 후면 카메라 전환" android:padding="0dp" android:backgroundTint="#333333" app:icon="@drawable/ic_switch_camera" app:iconGravity="textStart" app:iconSize="24dp" app:iconPadding="0dp" app:iconTint="#FFFFFF" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
