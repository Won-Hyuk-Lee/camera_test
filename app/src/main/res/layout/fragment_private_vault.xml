<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#121419" android:orientation="vertical" android:padding="12dp" android:fitsSystemWindows="true">
    <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="뒤로"/>
    <TextView android:id="@+id/txtVaultTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="비공개 보관함" android:textSize="20sp" android:textColor="#FFFFFF"/>
    <EditText android:id="@+id/searchQuery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="촬영 날짜 또는 파일명 검색" android:inputType="text" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#CCCCCC"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Spinner android:id="@+id/sortOrder" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="보관함 정렬"/>
        <Spinner android:id="@+id/statusFilter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="파일 상태 필터"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/selectVisible" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="전체 선택"/>
        <Button android:id="@+id/exportSelected" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="내보내기"/>
        <Button android:id="@+id/deleteSelected" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="삭제"/>
    </LinearLayout>
    <TextView android:id="@+id/selectionSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="#CCCCCC"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="120dp" android:visibility="gone">
        <LinearLayout android:id="@+id/exportStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
    <TextView android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="표시할 영상이 없습니다" android:textColor="#FFFFFF" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvVaultMedia" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
