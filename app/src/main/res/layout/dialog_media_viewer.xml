<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 미디어 컨테이너 (이미지뷰 또는 비디오뷰가 추가될 공간) -->
    <FrameLayout
        android:id="@+id/mediaContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <!-- 상단 반투명 컨트롤러 영역 -->
    <RelativeLayout
        android:id="@+id/toolbarViewer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#99000000"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btnViewerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close Viewer"
            app:tint="#FFFFFF"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/txtViewerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnViewerClose"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Media File Name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

</RelativeLayout>
